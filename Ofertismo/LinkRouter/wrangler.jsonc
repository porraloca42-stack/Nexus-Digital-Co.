{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ofertismo-link-router",
  "main": "src/index.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROUTER_STATE", "class_name": "LinkRouterState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LinkRouterState"] }]
}